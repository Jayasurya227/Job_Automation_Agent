# ==============================================================================
# Autonomous AI Job Application Agent - Docker Environment Template
# Copy this file to .env before starting containers: `cp .env.docker.example .env`
# ==============================================================================

# Core AI Brain (Anthropic Claude - API billing required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-5-5

# Multi-Tenant Authentication & JWT Security (Generate a secure 64-char key)
SECRET_KEY=change_this_to_a_random_secure_hex_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Persistence (Defaults to SQLite in /app/data volume inside container)
DATABASE_URL=sqlite:////app/data/jobs.db

# Optional API Security Token Guard (leave blank to rely on JWT auth)
API_TOKEN=

# Host & Port Configuration (Container internal defaults)
HOST=0.0.0.0
PORT=8000

# Optional SMTP Notification Credentials
SENDER_EMAIL=
SENDER_NAME=
GMAIL_APP_PASSWORD=
