# Google Gemini API Key (Get a key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database Location (defaults to data/jobs.db if unset)
DATABASE_URL=sqlite:///data/jobs.db

# AI Model Selection (Optional, defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional API Security Token Guard (leave blank for open local dev)
API_TOKEN=

# SMTP Outreach Fallbacks (can also be configured via Web Settings)
SENDER_EMAIL=
SENDER_NAME=
GMAIL_APP_PASSWORD=
