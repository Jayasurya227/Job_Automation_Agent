# Anthropic Claude API Key (Get a key from https://console.anthropic.com/ - API billing required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLite Database Location (defaults to data/jobs.db if unset)
DATABASE_URL=sqlite:///data/jobs.db

# AI Model Selection (Optional, defaults to claude-haiku-5-5)
CLAUDE_MODEL=claude-haiku-5-5

# Optional API Security Token Guard (leave blank for open local dev)
API_TOKEN=

# SMTP Outreach Fallbacks (can also be configured via Web Settings)
SENDER_EMAIL=
SENDER_NAME=
GMAIL_APP_PASSWORD=
