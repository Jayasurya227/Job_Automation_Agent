# Anthropic Claude API Key (Get a key from https://console.anthropic.com/ - API billing required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLite Database Location (defaults to data/jobs.db if unset)
DATABASE_URL=sqlite:///data/jobs.db

# AI Model Selection (Optional, defaults to claude-haiku-5-5)
CLAUDE_MODEL=claude-haiku-5-5

# Optional API Security Token Guard (leave blank for open local dev)
API_TOKEN=

# SMTP Outreach Fallbacks (can also be configured via Web Settings)
SENDER_EMAIL=
SENDER_NAME=
GMAIL_APP_PASSWORD=

# Multi-User JWT Security Configuration
JWT_SECRET_KEY=generate_with_python_secrets_token_hex_32

# Indian Residential Proxy Configuration (Issue 10)
# Optional: Set this when deploying to Cloud VPS (AWS Sydney/GCP/Docker)
# to route browser traffic through genuine Indian residential IPs and bypass Akamai bot blocks.
# Example: RESIDENTIAL_PROXY_SERVER=http://p.webshare.io:80
RESIDENTIAL_PROXY_SERVER=
RESIDENTIAL_PROXY_USERNAME=
RESIDENTIAL_PROXY_PASSWORD=

# Dynamic Cloud CORS Origins (Issue 11)
# Comma-separated list of public cloud IPs or domain names allowed to access the backend API.
# Example: CORS_ALLOWED_ORIGINS=http://13.239.145.20:5173,https://myjobsite.com
CORS_ALLOWED_ORIGINS=
