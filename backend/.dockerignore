# ==============================================================================
# Docker Ignore Rules - Autonomous Job Automation Agent (Backend)
# Prevents host secrets, virtual environments, and transient caches from leaking
# ==============================================================================

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Secrets & Local Configurations
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Git & Version Control
.git/
.gitignore
.gitattributes

# IDE & Editor Artefacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.gemini/

# Testing & Quality Assurance
.pytest_cache/
.coverage
htmlcov/
test_*.py
tests/

# Large Browser Cache & Ephemeral Files
data/users/*/browser_session/
data/users/*/output/
output/snapshots/
output/resumes/
*.log
*.tmp
