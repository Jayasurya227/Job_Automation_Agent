# ==============================================================================
# Autonomous Job Automation Agent - Enterprise Git Ignore Policy
# Rule 2: Hardcore Security - Zero Secret & Credential Leakage
# ==============================================================================

# Environment Variables & Secrets
.env
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# Python Environments & Interpreters
venv/
backend/venv/
**/venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Python Cache & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Frontend Artifacts
node_modules/
frontend/node_modules/
**/node_modules/
dist/
frontend/dist/
**/dist/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database & State Stores (Local data retention only)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
data/*.db
backend/data/account_settings.json
backend/data/uploaded_resume.pdf
backend/data/browser_session/
**/browser_session/

# Generated Pipeline Output Artifacts (Resumes, Snapshots, TeX files)
output/
backend/output/
**/output/
backend/backend/
*.pdf
!backend/data/mock_*.pdf
*.tex
*.log
logs/

# Scratch & Temporary Test Folders
backend/scratch/
scratch/
tmp/
temp/

# IDE & OS Metadata
